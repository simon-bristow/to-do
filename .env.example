# --- Database (Neon/Supabase in production; local Postgres in dev) ---
DATABASE_URL=postgres://postgres@localhost:5432/todo

# --- Timezone used for due dates/times (Pipedrive stores times in UTC) ---
APP_TIMEZONE=Australia/Melbourne

# --- Auth (Google sign-in, locked to one email) ---
AUTH_SECRET=            # generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL=simon.bristow@everest.engineering
# Local development only: skip sign-in entirely (ignored in production)
AUTH_DISABLED=true

# --- Background sync endpoint (/api/sync) is protected by this bearer token ---
CRON_SECRET=

# --- Pipedrive ---
PIPEDRIVE_API_TOKEN=     # Pipedrive > Personal preferences > API
PIPEDRIVE_COMPANY_DOMAIN=everestengineering
PIPEDRIVE_USER_ID=23057966

# --- Slack Lists ---
SLACK_USER_TOKEN=        # xoxp-... with lists:read, lists:write
SLACK_LIST_ID=           # e.g. F0123ABCD (from the List's link)
# Optional column overrides (column IDs); auto-detected from the List schema otherwise
SLACK_COL_TITLE=
SLACK_COL_DONE=
SLACK_COL_DUE=
SLACK_COL_NOTES=
